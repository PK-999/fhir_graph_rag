# ── Environment ──
# Copy this file to .env and fill in values

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fhirgraph
POSTGRES_USER=fhirgraph
POSTGRES_PASSWORD=changeme_pg  # REQUIRED — set a unique password

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_neo4j  # REQUIRED — set a unique password

# HAPI FHIR
HAPI_FHIR_URL=http://localhost:8080/fhir

# API
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Synthetic data generation
GENERATION_SEED=20260830
GENERATION_PATIENT_COUNT=1000
GENERATION_ENCOUNTERS_MIN=10
GENERATION_ENCOUNTERS_MAX=20
GENERATION_HISTORY_YEARS=5
