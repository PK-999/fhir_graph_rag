COMPOSE_PROJECT_NAME=fhirgraph-demo
# ── Environment ──
# Copy this file to .env and fill in values

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=fhirgraph
POSTGRES_USER=fhirgraph
POSTGRES_PASSWORD=change-this-postgres-password

# Neo4j
NEO4J_URI=bolt://localhost:57687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-neo4j-password

# HAPI FHIR
HAPI_FHIR_URL=http://localhost:58080/fhir

# API
API_HOST=0.0.0.0
API_PORT=8010
API_LOG_LEVEL=info
READINESS_TIMEOUT_SECONDS=2
CORS_ORIGINS=http://localhost:4010,http://127.0.0.1:4010

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8010/api/v1

# Collision-safe host ports used by Docker Compose
FHIRGRAPH_WEB_PORT=4010
FHIRGRAPH_API_PORT=8010
FHIRGRAPH_POSTGRES_PORT=55432
FHIRGRAPH_NEO4J_HTTP_PORT=57474
FHIRGRAPH_NEO4J_BOLT_PORT=57687
FHIRGRAPH_HAPI_PORT=58080
FHIRGRAPH_PUBLIC_API_URL=http://localhost:8010/api/v1

# Local model server; no model is bundled or started by Compose
LLM_BASE_URL=http://localhost:11434/v1
FHIRGRAPH_LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=ollama

# Generation uses make PATIENTS=... SEED=... OUTPUT=... or pipelines.generate flags.
